# ---- このプロジェクト固有: 巨大な元データ（fbxと重複の書き出し元、GitHub上限超過のため除外） ----
/FG26_F/

# ビルド出力(standalone)。再生成可・巨大なので除外
/run/

# Python ML 学習用 venv（torch等・巨大・再生成可）
/ml/.venv310/
/ml/.venv*/

# ML-Agents 学習成果(results)・大容量で再生成可
/results/
/ml/results/

# 学習トレーナの実行ログ(肥大化・再生成可)
/ml/train_*.log
/ml/train_*.err.log
